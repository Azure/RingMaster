<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <SkipCopyBuildProduct>true</SkipCopyBuildProduct>
    <OutputPath Condition="'$(OutputPath)' == ''">$(OutputRoot)\</OutputPath>
    <OutDir Condition="'$(OutDir)' == ''">$(OutputPath)</OutDir>

    <MdsAgentPkg>$(OutputRoot)\MdsAgentApplication</MdsAgentPkg>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GenevaMonitoringAgent" GeneratePathProperty="true" IncludeAssets="none" />
    <PackageReference Include="Microsoft.ServiceFabric.Geneva" GeneratePathProperty="true" IncludeAssets="none" />
    <PackageReference Include="ServiceFabric.XCopyInstallers" GeneratePathProperty="true" IncludeAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <SfFilesToCopy Include="$(PkgServiceFabric_XCopyInstallers)\Fabric\Installer\*.*" />

    <!-- Copy the application package included in nuget package to build output  -->
    <AppFilesToCopy Include="$(PkgMicrosoft_ServiceFabric_Geneva)\MonitoringServiceWithMA\**\*.*" />
    <!-- Copy the Manifest files from the ServiceFabric.Geneva nuget package to the build output -->
    <AppFilesToCopy Include="$(SRCROOT)\Applications\MdsAgentApplication\ApplicationManifest.xml" />
    <!-- Default app parameters -->
    <AppFilesToCopy Include="$(SRCROOT)\Applications\MdsAgentApplication\DefaultApplicationParameters.xml" />

    <!-- patched version to run startup command -->
    <AgentSvcFiles Include="$(SRCROOT)\Applications\MdsAgentApplication\patch\**\*.*" />

    <!-- Copy the Geneva Monitoring Agent binaries from to the data package folder of MdsAgentService -->
    <AgentDatFiles Include="$(PkgGenevaMonitoringAgent)\Monitoring\agent\**\*.*" />
    <!-- Copy the ServiceFabricEvents.xml config file from ServiceFabric.Geneva nuget package to the data package folder of MdsAgentService -->
    <AgentDatFiles Include="$(PkgMicrosoft_ServiceFabric_Geneva)\content\MAConfig\**\*.*" />
    <!-- Vega MA config -->
    <AgentDatFiles Include="$(SRCROOT)\Applications\Mds\VegaMAConfig.Test.xml" />

    <MonitorSvcFiles Include="$(PkgMicrosoft_ServiceFabric_Geneva)\content\ManifestFiles\MonitoringServicePackage\ServiceManifest.xml" />
  </ItemGroup>

  <ItemGroup>
    <QCustomInput Include="$(SRCROOT)\Applications\MdsAgentApplication\patch\Startup.cmd" />
  </ItemGroup>

  <Target Name="CopyFiles" AfterTargets="Build">
    <Copy SourceFiles="@(SfFilesToCopy)" DestinationFiles="@(SfFilesToCopy->'$(OutputRoot)\ServiceFabric.XCopyPackage\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(AppFilesToCopy)" DestinationFiles="@(AppFilesToCopy->'$(MdsAgentPkg)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(AgentSvcFiles)" DestinationFiles="@(AgentSvcFiles->'$(MdsAgentPkg)\MdsAgentServicePackage\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(AgentDatFiles)" DestinationFiles="@(AgentDatFiles->'$(MdsAgentPkg)\MdsAgentServicePackage\MdsAgent.Data\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(MonitorSvcFiles)" DestinationFiles="@(MonitorSvcFiles->'$(MdsAgentPkg)\MonitoringServicePackage\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="CreateManifestResourceNames" />
  <Target Name="CoreCompile" />

</Project>
