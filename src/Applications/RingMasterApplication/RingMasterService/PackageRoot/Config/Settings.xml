<?xml version="1.0" encoding="utf-8" ?>
<Settings xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://schemas.microsoft.com/2011/01/fabric">
  <!-- This is used by the StateManager's replicator. -->
  <Section Name="ReplicatorConfig">
    <Parameter Name="ReplicatorEndpoint" Value="ReplicatorEndpoint" />
    <Parameter Name="MaxPrimaryReplicationQueueSize" Value="1073741824" />
    <Parameter Name="MaxSecondaryReplicationQueueSize" Value="1073741824" />
    <Parameter Name="MaxReplicationMessageSize" Value="209715200" /> <!-- 200 MB -->
  </Section>
  <!-- This is used for securing StateManager's replication traffic. -->
  <Section Name="ReplicatorSecurityConfig" />

  <Section Name="Monitoring">
    <Parameter Name="Environment" Value="" MustOverride="true" /> <!-- This setting is required. It identifies if we're running under azure SDK in that case this would be RoleEnvironment -->
    <Parameter Name="Tenant" Value="" MustOverride="true" />
    <Parameter Name="Role" Value="RingMasterService" />
    <Parameter Name="IfxSession" Value="" MustOverride="true" />
    <Parameter Name="MdmAccount" Value="" MustOverride="true" />
    <Parameter Name="MdmNamespace" Value="RingMasterWorker" />
  </Section>

  <Section Name="RingMasterService">
    <Parameter Name="AppConfigOverrides" Value="" />
    <Parameter Name="DebuggerAttachTimeout" Value="" />
    <Parameter Name="InMemoryPersistence" Value="" />
    <Parameter Name="SSL.UseSSL" Value="" />
    <Parameter Name="RingMaster.SecondaryPreprocessor.RunOnMultiplesOf" Value="" />
    <Parameter Name="RingMaster.DontStartPseudoNodes" Value="" />
    <Parameter Name="RingMaster.StartMainEndpointOnSecondary" Value="" />
    <Parameter Name="RingMaster.StartExtraEndpointsOnSecondary" Value="" />
    <Parameter Name="WireBackup.Enable" Value="" />
    <Parameter Name="WireBackup.Path" Value="" />
    <Parameter Name="WireBackup.MaxEvents" Value="" />
    <Parameter Name="WireBackup.MaxTimeInSeconds" Value="" />
    <Parameter Name="WireBackup.MaxEventsBetweenSnapshots" Value="" />
    <Parameter Name="WireBackup.MaxTimeBetweenSnapshotsInSeconds" Value="" />
    <Parameter Name="WireBackup.RetentionSeconds" Value="" />
    <Parameter Name="RingMaster.Transport.ClientConnection.MaxUnFlushedMillis" Value="" />
    <Parameter Name="RingMaster.Transport.ClientConnection.MaxUnFlushedResponses" Value="" />
    <Parameter Name="RingMaster.Transport.ClientConnection.MaxThreadsPerConnection" Value="" />
    <Parameter Name="RingMaster.Transport.ClientConnection.BufferSizeInBytes" Value="" />
    <Parameter Name="RingMaster.Transport.ClientConnection.MaxConnectionIdleTime" Value="" />
    <Parameter Name="RingMaster.Transport.ClientConnection.MaxConnectionLifespan" Value="" />
    <Parameter Name="RingMaster.Transport.ClientSession.MaxUnFlushedMillis" Value="" />
    <Parameter Name="RingMaster.Transport.ClientSession.MaxUnFlushedResponses" Value="" />
    <Parameter Name="RingMaster.Transport.ClientSession.MaxThreadsPerClient" Value="" />
    <Parameter Name="RingMaster.Transport.ClientSession.BufferSizeInBytes" Value="" />
    <Parameter Name="RingMaster.Transport.Server.MaxAllowedConnections" Value="" />
    <Parameter Name="RingMaster.Paths.NotAllowedToFail" Value="" />
    <Parameter Name="RingMaster.Paths.IgnoreForLockDown" Value="" />
    <Parameter Name="RingMaster.LockStrategy" Value="" />
    <Parameter Name="WinFabPersistence.HotSecondary" Value="" />
