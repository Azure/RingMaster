    <Parameter Name="WinFabPersistence.FixStatDuringLoad" Value="" />
    <Parameter Name="WinFabPersistence.IgnoreErrorsDuringLoad" Value="" />
    <Parameter Name="RingMasterLimits.MaxGetChildrenEnumerationCount" Value="" /> 
    <Parameter Name="RingMaster.MaxRetryOperationMillis" Value="" /> 
    <Parameter Name="RingMaster.MaxSessionIdleSeconds" Value="" />
    <Parameter Name="RingMaster.LockSizesPerLevel" Value="1,50,2500,10000,100000,500000" />
  </Section>
</Settings>
