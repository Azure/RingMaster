<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.13.11" />
    <PackageVersion Include="Common.RSL.amd64" Version="1.2.55" />
    <PackageVersion Include="GenevaMonitoringAgent" Version="45.3.1" />
    <PackageVersion Include="Google.Protobuf" Version="3.21.5" />
    <PackageVersion Include="Google.Protobuf.Tools" Version="3.21.5" />
    <PackageVersion Include="Grpc" Version="2.46.3" />
    <PackageVersion Include="Grpc.Tools" Version="2.46.3" />
    <PackageVersion Include="MSTest.TestAdapter" Version="2.2.8" />
    <PackageVersion Include="MSTest.TestFramework" Version="2.2.8" />
    <PackageVersion Include="Microsoft.Cloud.InstrumentationFramework.NetStd" Version="1.2.1011530001" />
    <PackageVersion Include="Bond.CSharp" Version="13.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="6.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="6.0.0" />
    <PackageVersion Include="Microsoft.IO.RecyclableMemoryStream" Version="2.2.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.0.0" />
    <PackageVersion Include="Microsoft.ServiceFabric" Version="8.0.521" />
    <PackageVersion Include="Microsoft.ServiceFabric.Data" Version="5.0.521" />
    <PackageVersion Include="Microsoft.ServiceFabric.Data.Extensions" Version="5.0.521" />
    <PackageVersion Include="Microsoft.ServiceFabric.Data.Interfaces" Version="5.0.521" />
    <PackageVersion Include="Microsoft.ServiceFabric.Diagnostics.Internal" Version="5.0.521" />
    <PackageVersion Include="Microsoft.ServiceFabric.Geneva" Version="6.1.467" />
    <PackageVersion Include="Microsoft.ServiceFabric.Services" Version="5.0.521" />
    <PackageVersion Include="NSubstitute" Version="4.2.2" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.1" />
    <!-- Contains source generators for adding special attributes used by C# compiler to use the latest features regardless of target runtime. -->
    <PackageVersion Include="PolySharp " Version="1.14.1" />
    <PackageVersion Include="PowerShellStandard.Library" Version="5.1.1" />
    <PackageVersion Include="ServiceFabric.XCopyInstallers" Version="10.1.2941.9591" />    <!-- Have to use a beta version for now (Mar2024) in order to use nullable reference types. -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <PackageVersion Include="System.CodeDom" Version="6.0.0" />
    <PackageVersion Include="System.IO.Pipelines" Version="6.0.1" />
    <PackageVersion Include="System.Memory" Version="4.5.4" />
    <PackageVersion Include="System.Security.Permissions" Version="6.0.0" />
    <PackageVersion Include="System.ServiceModel.Primitives" Version="4.9.0" />
    <PackageVersion Include="System.Text.Json" Version="8.0.5" />
    <PackageVersion Include="VisualStudio.Coverage" Version="1.0.1" />
  </ItemGroup>
  <ItemGroup Label="CodeAnalysis">
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="6.0.0" Condition="'$(MSBuildProjectExtension)' == '.csproj' AND '$(RunCA)' == 'true'">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </GlobalPackageReference>
  </ItemGroup>
</Project>